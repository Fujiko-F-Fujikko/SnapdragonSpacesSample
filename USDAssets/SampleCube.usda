#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "RedCube"
    {
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        float3 xformOp:rotateXYZ = (0, -15, 0)
        double3 xformOp:translate = (-0.75, 0, 0)
        double3 xformOp:scale = (1.5, 1.5, 1.5)

        def Cube "Geom"
        {
            double size = 1
            color3f[] primvars:displayColor = [ (1, 0, 0) ]
        }
    }

    def Xform "BlueCube"
    {
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        double3 xformOp:translate = (0.75, 0, 0)
        double3 xformOp:rotateXYZ = (0, 45, 0) 
        double3 xformOp:scale = (0.5, 0.5, 0.5)

        def Cube "Geom"
        {
            double size = 1
            color3f[] primvars:displayColor = [ (0, 0, 1) ]
        }
    }

    def Xform "BlueCube2"
    {
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        double3 xformOp:translate = (1.5, 0, 0)
        double3 xformOp:rotateXYZ = (0, 45, 0) 
        double3 xformOp:scale = (0.5, 0.5, 0.5)

        def Cube "Geom"
        {
            double size = 1
            color3f[] primvars:displayColor = [ (0, 0, 1) ]
        }
    }

}
